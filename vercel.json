{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "installCommand": "npm install",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    },
    "backend": {
      "root": "backend",
      "installCommand": "npm install",
      "buildCommand": "npm run build",
      "runtime": "node",
      "entrypoint": "src/server.ts"
    }
  }
}