{
  "framework": "express",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { 
      "source": "/src/(.*)", 
      "destination": "/src/server.ts" 
    }
  ],
  "routes": [
    {
      "src": "/src/(.*)",
      "dest": "/src/routers/pokemon.ts",
      "methods": ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"]
    }
  ]
}